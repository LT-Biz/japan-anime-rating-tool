{
  "name": "japan-anime-rating-tool",
  "version": "1.0.0",
  "description": "일본 애니메이션 방영 정보(요일별 편성/신작/검색)를 보여주는 정적 웹 페이지",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build-syoboi.js --soft && node scripts/build-webnovel.js --soft",
    "build:syoboi": "node scripts/build-syoboi.js",
    "build:webnovel": "node scripts/build-webnovel.js",
    "dev": "node --watch server.js"
  },
  "devDependencies": {
    "express": "^4.19.2"
  }
}
